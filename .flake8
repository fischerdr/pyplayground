[flake8]
docstring-convention = google
max-line-length = 180
max-complexity = 10
exclude =
    .git,
    __pycache__,
    build,
    dist,
    .venv,
    tools
ignore =
    # Complexity warnings - ignored as acceptable
    C901,
    # Missing docstring in public module
    D100,
    # Missing docstring in public package
    D104,
    # Missing docstring in magic method
    D105,
    # Missing docstring in __init__
    D107,
   # First line should be in imperative mood; try rephrasing
    D401,
    # One-line docstring should fit on one line with quotes
    D200,
    # Whitespace before ':'
    E203,
    # Import errors - imports must be at top of the file
    E402,
    # Line too long - i give up
    E501,
    # Assigned but not used
    F841,
    # Unable to detect undefinded names
    F403,
    # line break before binary operator
    W503,
   
per-file-ignores =
    # Allow unused imports in __init__.py
    __init__.py:F401
    # Allow missing docstrings in tests
    test_*.py:D100,D101,D102,D103
